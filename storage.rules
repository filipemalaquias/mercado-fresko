rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /produtos/{uid}/{produtoId}/{ficheiro} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && ficheiro.matches('^[A-Za-z0-9._-]{1,120}$')
        && firestore.exists(
          /databases/(default)/documents/produtos/$(produtoId)
        )
        && firestore.get(
          /databases/(default)/documents/produtos/$(produtoId)
        ).data.comercianteId == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
